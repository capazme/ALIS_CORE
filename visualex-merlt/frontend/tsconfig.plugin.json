{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Override noEmit for plugin build
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist/types"
  },
  "include": ["src/vite-env.d.ts", "src/plugin/index.ts", "src/components/**/*.tsx", "src/services/**/*.ts", "src/types/**/*.ts", "src/hooks/**/*.ts", "src/store/**/*.ts", "src/utils/**/*.ts", "src/lib/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/main.tsx", "src/App.tsx", "src/**/__tests__", "src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.spec.ts", "src/**/*.spec.tsx", "src/test"]
}
